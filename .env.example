# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Neon PostgreSQL
# Use real values only in .env.local or Vercel Environment Variables.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Neon Auth
# Managed Better Auth URL returned by Neon provisioning.
NEON_AUTH_BASE_URL=
# At least 32 characters. Keep the real value in .env.local or Vercel only.
NEON_AUTH_COOKIE_SECRET=
